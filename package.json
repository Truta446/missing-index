{
  "name": "missing-index",
  "version": "0.2.0",
  "description": "Find the missing database index. Explains slow queries at runtime and prints the CREATE INDEX that fixes them, with the line of code that ran them. PostgreSQL and MySQL.",
  "keywords": [
    "index",
    "missing-index",
    "postgres",
    "postgresql",
    "explain",
    "seq-scan",
    "performance",
    "slow-query",
    "database",
    "query",
    "optimization",
    "drizzle",
    "knex",
    "typeorm",
    "prisma",
    "mysql",
    "mariadb",
    "n+1",
    "ci"
  ],
  "license": "MIT",
  "author": "Juan Versolato <juan.versolato@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Truta446/missing-index.git"
  },
  "bugs": {
    "url": "https://github.com/Truta446/missing-index/issues"
  },
  "homepage": "https://github.com/Truta446/missing-index#readme",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/adapters/pg.d.ts",
      "import": "./dist/adapters/pg.js",
      "require": "./dist/adapters/pg.js",
      "default": "./dist/adapters/pg.js"
    },
    "./package.json": "./package.json",
    "./mysql2": {
      "types": "./dist/adapters/mysql2.d.ts",
      "import": "./dist/adapters/mysql2.js",
      "require": "./dist/adapters/mysql2.js",
      "default": "./dist/adapters/mysql2.js"
    },
    "./drizzle": {
      "types": "./dist/adapters/drizzle.d.ts",
      "import": "./dist/adapters/drizzle.js",
      "require": "./dist/adapters/drizzle.js",
      "default": "./dist/adapters/drizzle.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js",
      "require": "./dist/test.js",
      "default": "./dist/test.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json && node --test dist-test/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "coverage": "tsc -p tsconfig.json && node --test --experimental-test-coverage dist-test/test/*.test.js",
    "prepublishOnly": "npm run build",
    "lint": "biome lint src test",
    "lint:fix": "biome lint --write src test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2"
  }
}
